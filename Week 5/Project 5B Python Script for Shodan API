from shodan import Shodan
import json
#Please provide your own Shodan API. Mine not provided for security reasons. Thanks for your understanding.
#To get Shodan API you need to have an account with Shodan, and then search Shodan API Keys to find your own API key.
api_key = Shodan('<<API KEY>>')
class ShodanHostDetailsParser:
    def parse_host_details(self, ip_address):
        """
        Print details about the given IP address.
        Args:
             ip_address (str): IP address to scan
        """
        ipinfo =api_key.host(ip_address)

        filename = "Shodan Project B2.json"
        print(f"Writing JSON to: {filename}")
        with open(filename, "w", encoding="utf-8") as f:
            json.dump(ipinfo, f, indent=4, ensure_ascii=False)
        print(f"Saved Shodan results to: {filename}")

        # Converting the response to JSON using json.dumps and then load it in a JSON object.
        json_data = json.loads(json.dumps(ipinfo))

        # Printing the attributes we need. The get () functions can be used to get specific attributes.
        print('city:', json_data.get('city'))
        print('latitude:', json_data.get('latitude'))
        print('longitude:', json_data.get('longitude'))
        print('country_name:', json_data.get('country_name'))

if __name__ == '__main__':
    shodan_host_details_parser = ShodanHostDetailsParser()
    shodan_host_details_parser.parse_host_details('8.8.8.8')
